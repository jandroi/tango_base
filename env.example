# <project> — environment configuration TEMPLATE
# Copy this file to `.env` (gitignored) and fill in real values:
#     Copy-Item env.example .env
# NEVER commit `.env`.

# --- Django ---
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email (console backend prints mail to the terminal; switch to smtp for prod) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
